<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration
        PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">

<generatorConfiguration>

    <context id="AmigoCContext" targetRuntime="MyBatis3">

        <commentGenerator>
            <property name="suppressDate" value="true"/>
            <property name="suppressAllComments" value="false"/>
        </commentGenerator>

        <!-- TODO: Update DB connection -->
        <jdbcConnection driverClass="oracle.jdbc.OracleDriver"
                        connectionURL="jdbc:oracle:thin:@localhost:1521:XE"
                        userId="your_username"
                        password="your_password"/>

        <javaTypeResolver>
            <property name="forceBigDecimals" value="false"/>
        </javaTypeResolver>

        <!-- Domain/Entity output -->
        <javaModelGenerator
                targetPackage="migration.mybatis.domain"
                targetProject="gen/main/java">
            <property name="enableSubPackages" value="true"/>
            <property name="trimStrings" value="true"/>
        </javaModelGenerator>

        <!-- Mapper XML output -->
        <sqlMapGenerator
                targetPackage="migration.mybatis.mapper.amigo_0149_c"
                targetProject="gen/main/resources">
            <property name="enableSubPackages" value="true"/>
        </sqlMapGenerator>

        <!-- Mapper Interface output -->
        <javaClientGenerator type="XMLMAPPER"
                targetPackage="migration.mybatis.mapper"
                targetProject="gen/main/java">
            <property name="enableSubPackages" value="true"/>
        </javaClientGenerator>

        <!-- TODO: Add your actual table names -->
        <table tableName="AMIGO_0149_C" domainObjectName="AmigoC"/>

    </context>
</generatorConfiguration>
