<?xml version="1.0" encoding="Shift-JIS"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="migration.mapper.target.ApplicationTargetMapper">

    <!-- Insert to target - Week 3-4: TEST TABLE (ID is NOT NULL, use sequence) -->
    <insert id="insert" parameterType="migration.domain.target.ApplicationTarget">
        INSERT INTO TEST (
            ID,
            申込番号,
            申込目的
        ) VALUES (
            TEST_SEQ.NEXTVAL,
            #{申込番号},
            #{申込目的}
        )
    </insert>

    <!-- Delete all (for testing) -->
    <delete id="deleteAll">
        DELETE FROM TEST
    </delete>

</mapper>
