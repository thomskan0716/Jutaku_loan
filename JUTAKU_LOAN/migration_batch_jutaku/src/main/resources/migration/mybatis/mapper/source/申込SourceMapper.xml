<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="migration.mapper.source.申込SourceMapper">

    <resultMap id="applicationSourceMap" type="migration.domain.source.申込Source">
        <id property="申込番号" column="申込番号"/>
        <result property="申込目的" column="申込目的"/>
    </resultMap>

    <!--
        ROW_NUMBER() based range query for 移行管理テーブル parallel processing.
        fromNo/toNo correspond to 移行管理テーブル.処理FROM / 処理TO.

        TODO: Replace placeholder WHERE clause with Jutaku-specific join/filter once confirmed:
              JOIN 申込審査状況 k ON s.申込番号 = k.申込番号
              WHERE k.審査完了区分 = [confirmed_value]
              AND s.申込目的 IN ('10', '15', '20', '30')
    -->
    <select id="selectByRowRange" resultMap="applicationSourceMap">
        <![CDATA[
        SELECT 申込番号, 申込目的
        FROM (
            SELECT s.申込番号,
                   s.申込目的,
                   ROW_NUMBER() OVER (ORDER BY s.申込番号) AS rn
            FROM 申込 s
            WHERE s.申込目的 IN ('10', '15', '20', '30')
        )
        WHERE rn BETWEEN #{fromNo} AND #{toNo}
        ]]>
    </select>

    <select id="selectByApplicationIdAndPurpose" resultMap="applicationSourceMap">
        SELECT
            申込番号,
            申込目的
        FROM 申込
        WHERE 申込番号 = #{申込番号}
          AND 申込目的 = #{申込目的}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM 申込
        WHERE 申込目的 IN ('10', '15', '20', '30')
    </select>

</mapper>
