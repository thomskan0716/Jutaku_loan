    <!--
        ROW_NUMBER() range query for 移行管理テーブル parallel processing.
        Driving table is 申込進捗 (not 申込), so this query is used only by
        selectByApplicationIdAndPurpose. selectByRowRange is kept for completeness.
    -->
    <select id="selectByRowRange" resultMap="applicationSourceMap">
        <![CDATA[
        SELECT *
        FROM (
            SELECT a.*,
                   w.上場フラグ      AS w上場フラグ,
                   w.国家資格        AS w国家資格,
                   w.配偶者年収      AS w配偶者年収,
                   ROW_NUMBER() OVER (ORDER BY a.申込番号) AS rn
            FROM 申込 a
            LEFT JOIN 申込ワイド w ON w.申込番号 = a.申込番号 AND w.申込目的 = a.申込目的
            WHERE a.申込目的 IN ('10', '15', '20', '30')
        )
        WHERE rn BETWEEN #{fromNo} AND #{toNo}
        ]]>
    </select>

    <select id="selectByApplicationIdAndPurpose" resultMap="applicationSourceMap">
        SELECT a.*,
               w.上場フラグ     AS w上場フラグ,
               w.国家資格       AS w国家資格,
               w.配偶者年収     AS w配偶者年収
        FROM 申込 a
        LEFT JOIN 申込ワイド w ON w.申込番号 = a.申込番号 AND w.申込目的 = a.申込目的
        WHERE a.申込番号 = #{申込番号}
          AND a.申込目的 = #{申込目的}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM 申込
        WHERE 申込目的 IN ('10', '15', '20', '30')
    </select>

