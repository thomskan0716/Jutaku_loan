<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="migration.mapper.target.審査モデル回答TargetMapper">

    <!-- 1:N per (申込番号, 申込目的). 申込番号 2->3 and 申込目的 converted by service. -->
    <insert id="insert" parameterType="migration.domain.target.審査モデル回答Target">
        INSERT INTO 審査モデル回答 (
            申込番号, 申込目的, イベント, イベント日時, セグメント, スコア
        ) VALUES (
            #{申込番号}, #{申込目的}, #{イベント}, #{イベント日時}, #{セグメント}, #{スコア}
        )
    </insert>

</mapper>
