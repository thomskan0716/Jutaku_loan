<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="migration.mapper.source.申込審査履歴SourceMapper">

    <resultMap id="reviewHistorySourceMap" type="migration.domain.source.申込審査履歴Source">
        <id property="申込番号"   column="申込番号"/>
        <id property="申込目的"   column="申込目的"/>
        <id property="回数"       column="回数"/>
        <result property="イベント"   column="イベント"/>
        <result property="イベント日時" column="イベント日時"/>
        <result property="進捗コード"   column="進捗コード"/>
        <result property="ユーザＩＤ"   column="ユーザＩＤ"/>
        <result property="ユーザ名"     column="ユーザ名"/>
    </resultMap>

    <select id="selectByApplicationIdAndPurpose" resultMap="reviewHistorySourceMap">
        SELECT
            申込番号,
            申込目的,
            イベント,
            イベント日時,
            進捗コード,
            ユーザＩＤ,
            ユーザ名,
            回数
        FROM 申込審査履歴
        WHERE 申込番号 = #{申込番号}
          AND 申込目的 = #{申込目的}
        ORDER BY 回数
    </select>

</mapper>
