<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="migration.mapper.target.申込TargetMapper">

    <!--
        [TEST] Insert to TEST table for connection/insert verification
        Switch to 申込 table after testing is confirmed
        Target: ITF_GMS.TEST (E00736SV0001)
    -->
    <insert id="insert" parameterType="migration.domain.target.申込Target">
        INSERT INTO TEST (
            ID,
            申込番号,
            申込目的
        ) VALUES (
            TEST_SEQ.NEXTVAL,
            #{申込番号},
            #{申込目的}
        )
    </insert>

    <!-- Delete all (for testing only - remove before production) -->
    <delete id="deleteAll">
        DELETE FROM TEST
    </delete>

</mapper>
