<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="migration.mapper.target.申込TargetMapper">

    <!-- MAX 申込目的 per group only (事前: '10', 正式: '20'). 申込番号 first digit already 2→3. -->
    <insert id="insert" parameterType="migration.domain.target.申込Target">
        INSERT INTO 申込 (
            申込番号,
            申込目的
        ) VALUES (
            #{申込番号},
            #{申込目的}
        )
    </insert>

    <!-- For testing only -->
    <delete id="deleteAll">
        DELETE FROM 申込
    </delete>

</mapper>
