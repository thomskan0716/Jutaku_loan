<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="migration.mapper.target.申込審査状況TargetMapper">

    <!-- History parent: all completed rows per group with ascending 回数. -->
    <insert id="insert" parameterType="migration.domain.target.申込審査状況Target">
        INSERT INTO 申込審査状況 (
            申込番号,
            申込目的,
            回数
        ) VALUES (
            #{申込番号},
            #{申込目的},
            #{回数}
        )
    </insert>

    <!-- For testing only -->
    <delete id="deleteAll">
        DELETE FROM 申込審査状況
    </delete>

</mapper>
