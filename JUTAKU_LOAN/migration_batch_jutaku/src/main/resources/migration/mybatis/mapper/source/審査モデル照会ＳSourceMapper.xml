<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="migration.mapper.source.審査モデル照会ＳSourceMapper">

    <resultMap id="scoringInquirySMap" type="migration.domain.source.審査モデル照会ＳSource">
        <id property="申込番号"     column="申込番号"/>
        <id property="申込目的"     column="申込目的"/>
        <id property="イベント"     column="イベント"/>
        <id property="イベント日時" column="イベント日時"/>
        <result property="状態"     column="状態"/>
        <result property="状態説明" column="状態説明"/>
        <result property="優先度"   column="優先度"/>
    </resultMap>

    <select id="selectByApplicationIdAndPurpose" resultMap="scoringInquirySMap">
        SELECT 申込番号, 申込目的, イベント, イベント日時, 状態, 状態説明, 優先度
        FROM 審査モデル照会Ｓ
        WHERE 申込番号 = #{申込番号}
          AND 申込目的 = #{申込目的}
        ORDER BY イベント日時
    </select>

</mapper>
