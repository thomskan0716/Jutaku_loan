<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="migration.mapper.source.審査モデル回答判定SourceMapper">

    <resultMap id="scoringJudgeMap" type="migration.domain.source.審査モデル回答判定Source">
        <id property="申込番号"     column="申込番号"/>
        <id property="申込目的"     column="申込目的"/>
        <id property="イベント"     column="イベント"/>
        <id property="イベント日時" column="イベント日時"/>
        <result property="融資倍率"     column="融資倍率"/>
        <result property="規定外項目"   column="規定外項目"/>
        <result property="担保掛目"     column="担保掛目"/>
        <result property="上限融資金額" column="上限融資金額"/>
        <result property="判定"         column="判定"/>
    </resultMap>

    <select id="selectByApplicationIdAndPurpose" resultMap="scoringJudgeMap">
        SELECT 申込番号, 申込目的, イベント, イベント日時,
               融資倍率, 規定外項目, 担保掛目, 上限融資金額, 判定
        FROM 審査モデル回答判定
        WHERE 申込番号 = #{申込番号}
          AND 申込目的 = #{申込目的}
        ORDER BY イベント日時
    </select>

</mapper>
