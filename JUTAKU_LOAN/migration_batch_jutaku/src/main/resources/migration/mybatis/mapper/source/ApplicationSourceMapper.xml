<?xml version="1.0" encoding="Shift-JIS"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="migration.mapper.source.ApplicationSourceMapper">

    <resultMap id="applicationSourceMap" type="migration.domain.source.ApplicationSource">
        <id property="申込番号" column="申込番号"/>
        <result property="申込目的" column="申込目的"/>
    </resultMap>

    <!-- Select by Range (F-Level Pattern) - Week 3-4: Only 2 columns, Limited to BATCH_SIZE -->
    <!-- NOTE: FOR UPDATE removed temporarily for testing - Oracle doesn't allow FOR UPDATE with FETCH FIRST -->
    <select id="selectByRange" resultMap="applicationSourceMap">
        SELECT
            申込番号,
            申込目的
        FROM 申込
        WHERE 申込番号 BETWEEN #{startId} AND #{endId}
        ORDER BY 申込番号
        FETCH FIRST 10 ROWS ONLY
    </select>

    <!-- Count total records (TEST: Limited to first 100 by 申込番号) -->
    <select id="count" resultType="long">
        <![CDATA[
        SELECT COUNT(*) FROM (
            SELECT 申込番号 FROM 申込 ORDER BY 申込番号 FETCH FIRST 100 ROWS ONLY
        )
        ]]>
    </select>

    <!-- Find min/max IDs for range processing (TEST: Limited to first 100 by 申込番号) -->
    <select id="findMinId" resultType="string">
        <![CDATA[
        SELECT MIN(申込番号) FROM (
            SELECT 申込番号 FROM 申込 ORDER BY 申込番号 FETCH FIRST 100 ROWS ONLY
        )
        ]]>
    </select>

    <select id="findMaxId" resultType="string">
        <![CDATA[
        SELECT MAX(申込番号) FROM (
            SELECT 申込番号 FROM 申込 ORDER BY 申込番号 FETCH FIRST 100 ROWS ONLY
        )
        ]]>
    </select>

</mapper>
