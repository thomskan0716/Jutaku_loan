<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="migration.mapper.source.申込審査段階SourceMapper">

    <resultMap id="reviewStageSourceMap" type="migration.domain.source.申込審査段階Source">
        <id property="申込番号"     column="申込番号"/>
        <id property="申込目的"     column="申込目的"/>
        <result property="審査完了区分" column="審査完了区分"/>
    </resultMap>

    <!--
        Fetch all 申込審査段階 rows for one 申込番号.
        ORDER BY 申込目的 ASC so within each group (10/15, 20/30)
        the lowest old code comes first → ascending 回数 assignment in service.
    -->
    <select id="selectByApplicationId" resultMap="reviewStageSourceMap">
        SELECT
            申込番号,
            申込目的,
            審査完了区分
        FROM 申込審査段階
        WHERE 申込番号 = #{申込番号}
        ORDER BY 申込目的
    </select>

</mapper>
