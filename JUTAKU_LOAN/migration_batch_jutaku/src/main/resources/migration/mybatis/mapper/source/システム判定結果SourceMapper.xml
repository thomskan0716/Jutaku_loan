<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="migration.mapper.source.システム判定結果SourceMapper">

    <resultMap id="systemJudgeResultMap" type="migration.domain.source.システム判定結果Source">
        <id property="申込番号"     column="申込番号"/>
        <id property="申込目的"     column="申込目的"/>
        <id property="イベント"     column="イベント"/>
        <id property="イベント日時" column="イベント日時"/>
        <result property="システム判定結果" column="システム判定結果"/>
    </resultMap>

    <select id="selectByApplicationIdAndPurpose" resultMap="systemJudgeResultMap">
        SELECT 申込番号, 申込目的, イベント, イベント日時, システム判定結果
        FROM システム判定結果
        WHERE 申込番号 = #{申込番号}
          AND 申込目的 = #{申込目的}
        ORDER BY イベント日時
    </select>

</mapper>
