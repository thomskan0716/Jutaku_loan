<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="migration.mapper.target.システム判定照会TargetMapper">

    <!-- 1:N per (申込番号, 申込目的). 申込番号 2->3 and 申込目的 converted by service. -->
    <insert id="insert" parameterType="migration.domain.target.システム判定照会Target">
        INSERT INTO システム判定照会 (
            申込番号, 申込目的, イベント, イベント日時, 状態, 状態説明, 優先度
        ) VALUES (
            #{申込番号}, #{申込目的}, #{イベント}, #{イベント日時}, #{状態}, #{状態説明}, #{優先度}
        )
    </insert>

</mapper>
