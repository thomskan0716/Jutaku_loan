<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="migration.mapper.target.履歴申込TargetMapper">

    <!-- All completed 申込 rows per group, keyed by 回数. -->
    <insert id="insert" parameterType="migration.domain.target.履歴申込Target">
        INSERT INTO 履歴申込 (
            申込番号,
            申込目的,
            回数
        ) VALUES (
            #{申込番号},
            #{申込目的},
            #{回数}
        )
    </insert>

</mapper>
