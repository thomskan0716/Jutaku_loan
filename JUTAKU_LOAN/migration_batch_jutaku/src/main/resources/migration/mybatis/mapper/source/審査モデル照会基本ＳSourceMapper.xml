    <select id="selectByApplicationIdAndPurpose" resultMap="scoringInquiryBasicSMap">
        SELECT 申込番号, 申込目的, イベント, イベント日時,
               申込時年齢, 実行時年齢, 本人年収, 合算者年収, 合算方法, 申込金額,
               借入期間, 資金使途, 勤続年数, 資本金区分, 年間返済額, 総借入額,
               自己資金, 所要資金, 規定外項目, 担保評価額, 保証料区分, 先順位控除額,
               控除前担保評価額, 同居家族数
        FROM 審査モデル照会基本Ｓ
        WHERE 申込番号 = #{申込番号}
          AND 申込目的 = #{申込目的}
        ORDER BY イベント日時
    </select>

</mapper>
