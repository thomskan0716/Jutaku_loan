<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="migration.mapper.target.システム判定結果TargetMapper">

    <!-- 1:N per (申込番号, 申込目的). 申込番号 2->3 and 申込目的 converted by service. -->
    <insert id="insert" parameterType="migration.domain.target.システム判定結果Target">
        INSERT INTO システム判定結果 (
            申込番号, 申込目的, イベント, イベント日時, システム判定結果
        ) VALUES (
            #{申込番号}, #{申込目的}, #{イベント}, #{イベント日時}, #{システム判定結果}
        )
    </insert>

</mapper>
