<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="migration.mapper.source.審査モデル回答明細SourceMapper">

    <resultMap id="scoringDetailMap" type="migration.domain.source.審査モデル回答明細Source">
        <id property="申込番号"     column="申込番号"/>
        <id property="申込目的"     column="申込目的"/>
        <id property="イベント"     column="イベント"/>
        <id property="イベント日時" column="イベント日時"/>
        <result property="勤続年数評点"     column="勤続年数評点"/>
        <result property="勤続年数係数"     column="勤続年数係数"/>
        <result property="勤続年数スコア"   column="勤続年数スコア"/>
        <result property="借入年数評点"     column="借入年数評点"/>
        <result property="借入年数係数"     column="借入年数係数"/>
        <result property="借入年数スコア"   column="借入年数スコア"/>
        <result property="資本金評点"       column="資本金評点"/>
        <result property="資本金係数"       column="資本金係数"/>
        <result property="資本金スコア"     column="資本金スコア"/>
        <result property="合算返済比率評点"   column="合算返済比率評点"/>
        <result property="合算返済比率係数"   column="合算返済比率係数"/>
        <result property="合算返済比率スコア" column="合算返済比率スコア"/>
        <result property="合算返済比率"       column="合算返済比率"/>
        <result property="自己資金比率評点"   column="自己資金比率評点"/>
        <result property="自己資金比率係数"   column="自己資金比率係数"/>
        <result property="自己資金比率スコア" column="自己資金比率スコア"/>
        <result property="自己資金比率"       column="自己資金比率"/>
        <result property="調整定数"         column="調整定数"/>
        <result property="若年単身者評点"   column="若年単身者評点"/>
        <result property="若年単身者係数"   column="若年単身者係数"/>
        <result property="若年単身者スコア" column="若年単身者スコア"/>
    </resultMap>

    <select id="selectByApplicationIdAndPurpose" resultMap="scoringDetailMap">
        SELECT 申込番号, 申込目的, イベント, イベント日時,
               勤続年数評点, 勤続年数係数, 勤続年数スコア,
               借入年数評点, 借入年数係数, 借入年数スコア,
               資本金評点, 資本金係数, 資本金スコア,
               合算返済比率評点, 合算返済比率係数, 合算返済比率スコア, 合算返済比率,
               自己資金比率評点, 自己資金比率係数, 自己資金比率スコア, 自己資金比率,
               調整定数,
               若年単身者評点, 若年単身者係数, 若年単身者スコア
        FROM 審査モデル回答明細
        WHERE 申込番号 = #{申込番号}
          AND 申込目的 = #{申込目的}
        ORDER BY イベント日時
    </select>

</mapper>
