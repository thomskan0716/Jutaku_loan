<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="migration.mapper.target.審査ＫＳＣ信用情報詳細TargetMapper">

    <!-- 1:N per (申込番号, 申込目的). 申込番号 2->3 and 申込目的 converted by service.
         DB judgement columns use full-width digits (判断項目名１ ...); Java properties
         keep half-width digits. Target-only column 延滞回数 is left null. -->
    <insert id="insert" parameterType="migration.domain.target.審査ＫＳＣ信用情報詳細Target">
        INSERT INTO 審査ＫＳＣ信用情報詳細 (
            申込番号,
            申込目的,
            イベント,
            イベント日時,
            連番,
            別名連番,
            詳細連番,
            受付日時,
            受付番号,
            該当者通番,
            テーブル名,
            項目名,
            コード番号,
            コード,
            コード名称,
            氏名,
            氏名カナ,
            種類,
            信用情報判断,
            信用情報,
            判断項目名１,
            判断項目１,
            判断項目名２,
            判断項目２,
            判断項目名３,
            判断項目３,
            判断項目名４,
            判断項目４,
            判断項目名５,
            判断項目５,
            ブラック判断,
            発生日,
            契約日
        ) VALUES (
            #{申込番号},
            #{申込目的},
            #{イベント},
            #{イベント日時},
            #{連番},
            #{別名連番},
            #{詳細連番},
            #{受付日時},
            #{受付番号},
            #{該当者通番},
            #{テーブル名},
            #{項目名},
            #{コード番号},
            #{コード},
            #{コード名称},
            #{氏名},
            #{氏名カナ},
            #{種類},
            #{信用情報判断},
            #{信用情報},
            #{判断項目名1},
            #{判断項目1},
            #{判断項目名2},
            #{判断項目2},
            #{判断項目名3},
            #{判断項目3},
            #{判断項目名4},
            #{判断項目4},
            #{判断項目名5},
            #{判断項目5},
            #{ブラック判断},
            #{発生日},
            #{契約日}
        )
    </insert>

</mapper>
