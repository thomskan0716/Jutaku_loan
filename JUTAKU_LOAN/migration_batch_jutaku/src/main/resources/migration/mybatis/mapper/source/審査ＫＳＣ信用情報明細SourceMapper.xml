<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="migration.mapper.source.審査ＫＳＣ信用情報明細SourceMapper">

    <resultMap id="reviewKscCreditLineMap" type="migration.domain.source.審査ＫＳＣ信用情報明細Source">
        <id property="申込番号"     column="申込番号"/>
        <id property="申込目的"     column="申込目的"/>
        <id property="イベント"     column="イベント"/>
        <id property="イベント日時" column="イベント日時"/>
        <id property="連番"         column="連番"/>
        <id property="テーブル名"   column="テーブル名"/>
        <id property="項目名"       column="項目名"/>
        <id property="コード番号"   column="コード番号"/>
        <id property="コード"       column="コード"/>
        <result property="受付日時"   column="受付日時"/>
        <result property="受付番号"   column="受付番号"/>
        <result property="コード名称" column="コード名称"/>
        <result property="ブラック判断" column="ブラック判断"/>
    </resultMap>

    <select id="selectByApplicationIdAndPurpose" resultMap="reviewKscCreditLineMap">
        SELECT
            申込番号,
            申込目的,
            イベント,
            イベント日時,
            連番,
            受付日時,
            受付番号,
            テーブル名,
            項目名,
            コード番号,
            コード,
            コード名称,
            ブラック判断
        FROM 審査ＫＳＣ信用情報明細
        WHERE 申込番号 = #{申込番号}
          AND 申込目的 = #{申込目的}
        ORDER BY イベント日時, 連番, テーブル名, 項目名, コード番号, コード
    </select>

</mapper>
