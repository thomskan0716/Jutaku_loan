<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="migration.mapper.source.審査コメントSourceMapper">

    <resultMap id="reviewCommentMap" type="migration.domain.source.審査コメントSource">
        <id property="申込番号"     column="申込番号"/>
        <id property="申込目的"     column="申込目的"/>
        <id property="イベント"     column="イベント"/>
        <id property="イベント日時" column="イベント日時"/>
        <result property="コメント区分" column="コメント区分"/>
        <result property="結果種類"     column="結果種類"/>
        <result property="コメント"     column="コメント"/>
    </resultMap>

    <select id="selectByApplicationIdAndPurpose" resultMap="reviewCommentMap">
        SELECT 申込番号, 申込目的, イベント, イベント日時, コメント区分, 結果種類, コメント
        FROM 審査コメント
        WHERE 申込番号 = #{申込番号}
          AND 申込目的 = #{申込目的}
        ORDER BY イベント日時
    </select>

</mapper>
