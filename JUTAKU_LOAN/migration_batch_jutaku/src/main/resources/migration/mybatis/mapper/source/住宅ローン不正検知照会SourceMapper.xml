        <id property="申込目的"     column="申込目的"/>
        <id property="イベント"     column="イベント"/>
        <id property="イベント日時" column="イベント日時"/>
        <result property="状態"             column="状態"/>
        <result property="状態説明"         column="状態説明"/>
        <result property="優先度"           column="優先度"/>
        <result property="リクエストＩＤ"   column="リクエストＩＤ"/>
