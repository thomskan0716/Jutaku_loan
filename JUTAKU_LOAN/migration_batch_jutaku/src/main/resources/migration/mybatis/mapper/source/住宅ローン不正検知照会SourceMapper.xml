    <select id="selectByApplicationIdAndPurpose" resultMap="fraudDetectionInquiryMap">
        SELECT 申込番号, 申込目的, イベント, イベント日時,
               状態, 状態説明, 優先度, リクエストＩＤ,
               事前＿申込金額, 事前＿借入期間, 年齢, 勤務先従業員数, 勤続年数, 歩合給区分,
               年収, 自己資金, 家賃, 居住年数, 同居予定合計, 同居予定配偶者,
               土地担保時価額, 建物担保時価額, 借入総額, 年収倍率, 返済比率, 合算年収,
               年間返済額, 融資倍率, 総借入額＿総借入額,
               職業区分コード, 職種役職コード, 勤務先資本金区分, 資金使途,
               住居区分名称コード, セグメント, 住所郵便番号, 勤務先郵便番号, 物件郵便番号
        FROM 住宅ローン不正検知照会
        WHERE 申込番号 = #{申込番号}
          AND 申込目的 = #{申込目的}
        ORDER BY イベント日時
    </select>

