        <result property="土地担保時価額"   column="土地担保時価額"/>
        <result property="建物担保時価額"   column="建物担保時価額"/>
        <result property="借入総額"         column="借入総額"/>
        <result property="年収倍率"         column="年収倍率"/>
        <result property="返済比率"         column="返済比率"/>
