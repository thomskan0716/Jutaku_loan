spring:
  application:
    name: migration_batch_jutaku

  datasource:
    source:
      url: jdbc:oracle:thin:@E00736SV0001:1521:ORCL
      username: SZB_SMS
      password: SZB_SMS
      driver-class-name: oracle.jdbc.OracleDriver
    target:
      url: jdbc:oracle:thin:@E00736SV0001:1521:ORCL
      username: ITF_SMS
      password: SCP00ITF_SMS
      driver-class-name: oracle.jdbc.OracleDriver

  jpa:
    hibernate:
      ddl-auto: none
    show-sql: true
    properties:
      hibernate:
        format_sql: true
        dialect: org.hibernate.dialect.OracleDialect

  batch:
    job:
      enabled: true
    jdbc:
      initialize-schema: never

mybatis:
  mapper-locations: classpath*:migration/mybatis/mapper/**/*.xml
  type-aliases-package: migration.domain
  configuration:
    map-underscore-to-camel-case: false

logging:
  level:
    migration: DEBUG
    org.springframework.jdbc: DEBUG
    org.springframework.batch: INFO

migration:
  management:
    batch-size: 100
    max-iterations: -1
  range:
    batch-size: 100
    test-limit: 1000

---
spring:
  config:
    activate:
      on-profile: test

migration:
  management:
    batch-size: 100
    max-iterations: -1
  range:
    batch-size: 100
    test-limit: 1000
